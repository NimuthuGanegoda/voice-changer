{
  "name": "demo",
  "version": "1.0.0",
  "description": "",
  "main": ".eslintrc.js",
  "scripts": {
    "clean": "rimraf dist/",
    "webpack:prod": "webpack --config webpack.prod.js",
    "webpack:dev": "webpack --config webpack.dev.js",
    "build:prod": "npm-run-all clean webpack:prod",
    "build:dev": "npm-run-all clean webpack:dev",
    "start": "webpack serve --config webpack.dev.js",
    "test": "npm run typecheck",
    "____ comment ____": "ウェブバージョンのスクリプト",
    "clean:web": "rimraf dist_web/",
    "webpack:web:prod": "npx webpack --config webpack_web.prod.js && node -e \"const fs=require('fs');fs.copyFileSync('public/info_web','dist_web/info');fs.copyFileSync('public/assets/gui_settings/edition_web.txt','dist_web/assets/gui_settings/edition.txt')\"",
    "webpack:web:dev": "npx webpack --config webpack_web.dev.js && node -e \"const fs=require('fs');fs.copyFileSync('public/info_web','dist_web/info');fs.copyFileSync('public/assets/gui_settings/edition_web.txt','dist_web/assets/gui_settings/edition.txt')\"",
    "build:web:prod": "npm-run-all clean:web webpack:web:prod",
    "build:web:dev": "npm-run-all clean:web webpack:web:dev",
    "start:web": "webpack-dev-server  --config webpack_web.dev.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "voice conversion"
  ],
  "author": "wataru.okada@flect.co.jp",
  "license": "ISC",
