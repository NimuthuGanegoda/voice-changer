    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.6.2",
    "typescript": "5.9.3",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "webpack-merge": "6.0.1",
    "ts-jest": "29.4.15",
    "typescript-eslint": "8.72.2",
